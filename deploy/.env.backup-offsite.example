# Copy to /opt/sauti/.env.backup-offsite and chmod 600.
# Restic encrypts backup data before it leaves the server. The repository can
# be any Restic-supported destination, including S3-compatible object storage.
RESTIC_REPOSITORY=s3:https://OBJECT_STORAGE_ENDPOINT/BUCKET/sauti
RESTIC_PASSWORD=replace-with-a-long-random-encryption-password
AWS_ACCESS_KEY_ID=replace-with-object-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
