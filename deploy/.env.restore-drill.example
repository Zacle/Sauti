# Copy to /opt/sauti/.env.restore-drill and chmod 600.
# This database must be isolated, disposable, empty, and must not be production.
# Its database name must contain drill, restore, test, or staging.
SAUTI_RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED_HOST/sauti_restore_drill?sslmode=require
SAUTI_RESTORE_CONFIRM=isolated-restore-drill
